local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log

# database binary (regenerated via `prisma db push` + `prisma db seed`)
db/*.db

# archive files
*.tar.gz
*.zip

nohup.out

# Skills directory
/skills/

# agent context
/agent-ctx/