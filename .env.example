# ─── Supabase (REQUIRED) ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ─── NextAuth ────────────────────────────────────────────
NEXTAUTH_SECRET=generate-a-random-secret-here
# Change NEXTAUTH_URL to your actual domain after deploying
NEXTAUTH_URL=http://localhost:3000

# ─── AI Chatbot ──────────────────────────────────────────
# Choose provider: groq | grok | openai | gemini
#   groq    → FREE & ultra-fast! Get key from https://console.groq.com
#   grok    → FREE! Get key from https://console.x.ai
#   gemini  → FREE! Get key from https://aistudio.google.com/apikey
#   openai  → Paid, get key from https://platform.openai.com/api-keys
AI_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# (Optional) xAI Grok instead of Groq:
# AI_PROVIDER=grok
# GROK_API_KEY=your-xai-grok-api-key-here
# GROK_MODEL=grok-3-mini

# (Optional) Gemini instead of Groq:
# AI_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-2.0-flash

# (Optional) OpenAI instead of Groq:
# AI_PROVIDER=openai
# OPENAI_API_KEY=your-openai-key-here
# OPENAI_MODEL=gpt-4o-mini