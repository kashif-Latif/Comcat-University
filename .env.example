# ══════════════════════════════════════════════════════════════
# COMCAT University — Environment Variables
# Copy this file to `.env.local` for local dev,
# and set each of these in the Vercel dashboard for production.
# ══════════════════════════════════════════════════════════════

# ─── Supabase ─────────────────────────────────────────────────
# Get these from https://supabase.com/dashboard → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key

# ⚠️ SERVER-ONLY. Never expose. No NEXT_PUBLIC_ prefix.
# This key bypasses RLS. Only server-side code (API routes) should use it.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key


# ─── NextAuth ─────────────────────────────────────────────────
# Generate NEXTAUTH_SECRET with:  openssl rand -base64 32
NEXTAUTH_SECRET=change-me-generate-a-random-32-byte-secret
NEXTAUTH_URL=http://localhost:3000
# For production, set NEXTAUTH_URL to your Vercel URL, e.g.
# NEXTAUTH_URL=https://comcat-university.vercel.app


# ─── AI Chatbot ───────────────────────────────────────────────
# Groq is used first (free, fast). Gemini is the automatic fallback.
# You only need ONE of these to be set, but setting both gives resilience.
# Groq: https://console.groq.com
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini fallback: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.0-flash


# ─── Contact Form Mail (optional) ─────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
CONTACT_EMAIL=admin@comcat.edu.pk


# ─── Seed Endpoint Token ──────────────────────────────────────
# The /api/seed endpoint refuses to run unless the request includes
# `x-seed-token: <SEED_TOKEN>` matching this value. Unset this var
# after you're done seeding, or delete src/app/api/seed/route.ts entirely.
SEED_TOKEN=set-a-long-random-string-here
SEED_ADMIN_PASSWORD=ChangeMe@Admin1!
SEED_TEACHER_PASSWORD=ChangeMe@Teacher1!


# ─── (Optional) Legacy vars from the original code ────────────
# Left here for reference; the new AI chat route ignores these.
# AI_PROVIDER=groq
# AI_API_KEY=...
